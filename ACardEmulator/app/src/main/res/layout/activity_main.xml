<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary" android:theme="@style/AppTheme.AppBarOverlay"
        app:popupTheme="@style/AppTheme.PopupOverlay" />
    <androidx.core.widget.NestedScrollView android:fillViewport="true"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/localCardControls" android:orientation="horizontal"
                android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                    <TextView android:text="@string/fixture_format" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <Spinner android:id="@+id/documentFormat" android:contentDescription="@string/fixture_format"
                        android:layout_width="match_parent" android:layout_height="48dp" />
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                    <TextView android:text="@string/fixture_authentication" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <Spinner android:id="@+id/authenticationMode" android:contentDescription="@string/fixture_authentication"
                        android:layout_width="match_parent" android:layout_height="48dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/selectMFControls" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone">
                <TextView android:text="@string/select_mf_response" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/selectMFResponse" android:contentDescription="@string/select_mf_response"
                    android:layout_width="match_parent" android:layout_height="48dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/paControls" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Passive authentication · test CSCA" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/paScenario" android:contentDescription="Passive authentication scenario"
                    android:layout_width="match_parent" android:layout_height="48dp" />
            </LinearLayout>
            <CheckBox android:id="@+id/displayedImages" android:text="Additional images (DG5 / DG7)"
                android:paddingStart="12dp" android:layout_width="match_parent" android:layout_height="48dp" />
            <CheckBox android:id="@+id/biometricFiles" android:text="Biometric images (DG3 / DG4)"
                android:paddingStart="16dp" android:layout_width="match_parent" android:layout_height="48dp" />
            <CheckBox android:id="@+id/additionalDetails" android:text="Additional details (DG11 / DG12)"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" />
            <CheckBox android:id="@+id/securityFiles" android:text="Security information (DG14 / DG15)"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" />
            <CheckBox android:id="@+id/terminalAuth" android:text="Require terminal authorization for DG3 / DG4"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:visibility="gone" />
            <TextView android:id="@+id/textViewCardDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="16dp" android:paddingEnd="16dp" android:textIsSelectable="true" android:textSize="16sp" />
            <ImageView android:id="@+id/dg2Preview" android:layout_width="160dp" android:layout_height="120dp"
                android:layout_marginStart="16dp" android:layout_marginTop="8dp" android:scaleType="fitCenter"
                android:src="@drawable/dg2_td1_pace" android:contentDescription="@string/dg2_preview" />
            <LinearLayout android:id="@+id/displayedPreviews" android:orientation="horizontal" android:paddingStart="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
                <ImageView android:id="@+id/dg5Preview" android:layout_width="106dp" android:layout_height="80dp"
                    android:scaleType="fitCenter" android:contentDescription="DG5 displayed portrait test pattern" />
                <ImageView android:id="@+id/dg7Preview" android:layout_width="160dp" android:layout_height="80dp"
                    android:scaleType="fitCenter" android:contentDescription="DG7 signature test mark" />
            </LinearLayout>
            <TextView android:id="@+id/additionalDetailsPreview" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="16dp" android:textSize="14sp"
                android:lineSpacingExtra="2dp" android:textIsSelectable="true" android:visibility="gone" />
            <LinearLayout android:id="@+id/biometricPreviews" android:orientation="vertical" android:padding="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
                <TextView android:text="DG3 · Right index / Left index" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <ImageView android:id="@+id/fingerRightPreview" android:contentDescription="Synthetic right index fingerprint" android:layout_width="112dp" android:layout_height="112dp" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/fingerLeftPreview" android:contentDescription="Synthetic left index fingerprint" android:layout_width="112dp" android:layout_height="112dp" android:scaleType="fitCenter" />
                </LinearLayout>
                <TextView android:text="DG4 · Right eye / Left eye" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <ImageView android:id="@+id/irisRightPreview" android:contentDescription="Synthetic right iris" android:layout_width="112dp" android:layout_height="112dp" android:scaleType="fitCenter" />
                    <ImageView android:id="@+id/irisLeftPreview" android:contentDescription="Synthetic left iris" android:layout_width="112dp" android:layout_height="112dp" android:scaleType="fitCenter" />
                </LinearLayout>
                <TextView android:id="@+id/biometricPreviewInfo" android:textIsSelectable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/chipControls" android:orientation="horizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:text="Chip test" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/chipScenario" android:contentDescription="AA and CA test scenario"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
            </LinearLayout>
            <TextView android:id="@+id/securityFilesPreview" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="16dp" android:textSize="14sp"
                android:lineSpacingExtra="2dp" android:textIsSelectable="true" android:visibility="gone" />
            <LinearLayout android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/textViewCardStatus" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textStyle="bold" android:textSize="16sp" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:fabSize="mini" android:contentDescription="@string/reset_card" android:src="@mipmap/ic_reset" />
            </LinearLayout>
            <TextView android:text="@string/exchanges" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
            <TextView android:id="@+id/textViewLog" android:padding="16dp" android:textSize="12sp"
                    android:typeface="monospace" android:textIsSelectable="true"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
